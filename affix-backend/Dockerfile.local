FROM node:20-bullseye

WORKDIR /usr/src/app
COPY package.json ./
# Align the legacy Strapi plugin and Ajv peer versions for the currently resolved Strapi 4.x.
RUN npm pkg set "dependencies.@strapi/plugin-users-permissions=4.26.2" "dependencies.ajv=8.13.0" \
    && npm install --legacy-peer-deps --no-audit --no-fund
COPY . .

ENV HOST=0.0.0.0
ENV PORT=1337
EXPOSE 1337
CMD ["npm", "run", "develop"]
