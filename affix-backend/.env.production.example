# Copy to affix-backend/.env.production and fill real secrets.
# This file is git-ignored — never commit the filled-in version.
# Used by: docker-compose-production.yml (strapi-backend env_file)
#          Makefile (certbot-init / build-production / run-production targets
#          read this same file via --env-file)

HOST=0.0.0.0
PORT=1337

# --- Database (MySQL container on the "internal" network only) ---
DATABASE_CLIENT=mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=affix
DATABASE_USERNAME=strapi_production
DATABASE_PASSWORD=
DATABASE_SSL=false
MYSQL_ROOT_PASSWORD=

# --- Strapi secrets — generate unique random values per environment ---
# APP_KEYS: 4 comma-separated random base64 strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
JWT_SECRET=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=

# --- Cloudinary (media upload) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- Build-time only, consumed by docker-compose-production.yml for the
#     frontend image build arg (NOT read at container runtime) ---
REACT_APP_API_BASE_URL=https://api.affix-tech.com/api

# --- certbot-init Makefile target ---
CERTBOT_EMAIL=

# --- Optional: tag applied to built images (defaults to "production") ---
IMAGE_TAG=production
