.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt

# database dumps
*.sql
*.sqlite
*.sqlite3

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
