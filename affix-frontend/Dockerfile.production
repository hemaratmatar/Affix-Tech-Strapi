### First Stage — build the CRA app ###
FROM node:20-bullseye AS builder

WORKDIR /usr/src/app
COPY package.json ./
# Ensure CRA's refresh plugin resolves the supported peer, not Next's older transitive copy.
RUN npm pkg set "dependencies.react-refresh=0.11.0" \
    && npm install --legacy-peer-deps --no-audit --no-fund
COPY . .

ARG BASE_URL
ENV REACT_APP_BASE_URL=${BASE_URL}

RUN npm run build

### Second Stage — serve the static build with nginx ###
FROM nginx:1.27-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/src/app/build/ /usr/share/nginx/html

EXPOSE 80
