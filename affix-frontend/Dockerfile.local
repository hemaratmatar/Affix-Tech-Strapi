FROM node:20-bullseye

WORKDIR /usr/src/app
COPY package.json ./
# Ensure CRA's refresh plugin resolves the supported peer, not Next's older transitive copy.
RUN npm pkg set "dependencies.react-refresh=0.11.0" \
    && npm install --legacy-peer-deps --no-audit --no-fund
COPY . .

ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
CMD ["npm", "start"]
